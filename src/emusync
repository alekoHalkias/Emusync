#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Same list as PY_DEPS_PROBE in gui/electron/runtime.ts.
PROBE="import fastapi, uvicorn, click, tomlkit, zeroconf, httpx"
# venv lives at the repo root (install.sh: .venv, Makefile: .cache/.venv) since #611
for v in "$SCRIPT_DIR/../.cache/.venv" "$SCRIPT_DIR/../.venv" "$SCRIPT_DIR/.venv"; do
    [ -x "$v/bin/python" ] || continue
    "$v/bin/python" -c "$PROBE" 2>/dev/null && exec "$v/bin/python" "$SCRIPT_DIR/emusync.py" "$@"
    # #741: bin/python symlinks to the system python3, so a minor upgrade orphans
    # lib/pythonX.Y/site-packages. Rebuild; never fall back to a venv-less python3.
    # ponytail: no lock around the rebuild; add flock on "$v.lock" if concurrent launches race.
    echo "EmuSync: Python environment at $v is unusable (system Python changed?), rebuilding..." >&2
    if python3 -m venv --clear "$v" >&2 \
        && "$v/bin/python" -m pip install -q -r "$SCRIPT_DIR/requirements.txt" >&2 \
        && "$v/bin/python" -c "$PROBE" 2>/dev/null; then
        exec "$v/bin/python" "$SCRIPT_DIR/emusync.py" "$@"
    fi
    echo "EmuSync: could not rebuild the Python environment at $v ($(python3 --version 2>&1))." \
        "It needs python3 with the venv module and network access for pip." >&2
    exit 1
done
exec python3 "$SCRIPT_DIR/emusync.py" "$@"
